{
  "version": "v1",
  "hooks": [
    {
      "name": "🔍 CSS 变更校验（博客站点专属）",
      "description": "保存 CSS 文件后用纯脚本做最小校验（零依赖、零 LLM）：花括号配对 + 缺分号粗查。Astro 已接管 HTML，不再检查根目录 .html。",
      "trigger": "PostFileSave",
      "matcher": "(astro-site/src/styles/[^/]*\\.css$|astro-site/public/[^/]*\\.css$)",
      "action": {
        "type": "command",
        "command": "python3 .kiro/hooks/lib/check_html_css.py"
      },
      "enabled": false
    }
  ]
}
