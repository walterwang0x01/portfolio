---
import '@/styles/global.css';
import Analytics from '@/components/Analytics.astro';
import BackToTop from '@/components/BackToTop.astro';
import CommandPalette from '@/components/CommandPalette.astro';

interface Props {
  title: string;
  description?: string;
  activeNav?: 'blog' | 'briefing';
  ogImage?: string;
}

const { title, description = "Walter's Tech Blog — AI Agent 与工程实践", activeNav = 'blog', ogImage } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const BASE = import.meta.env.BASE_URL;
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site).toString() : undefined;
---
<!DOCTYPE html>
<html lang="zh-CN" data-base={BASE}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fafaf9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0d10" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="RSS" href={`${BASE}rss.xml`} />
    <!-- 第三方预连接：提前完成 DNS+TLS，省 100-300ms -->
    <link rel="preconnect" href="https://giscus.app" crossorigin />
    <link rel="preconnect" href="https://github.com" crossorigin />
    <link rel="dns-prefetch" href="https://sdk.51.la" />
    <link rel="dns-prefetch" href="https://busuanzi.ibruce.info" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>⚡</text></svg>" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && <meta property="og:image:width" content="1200" />}
    {ogImageUrl && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
    <title>{title}</title>
    <script is:inline>
      const saved = localStorage.getItem('theme');
      if (saved) document.documentElement.setAttribute('data-theme', saved);
      else if (window.matchMedia('(prefers-color-scheme: dark)').matches) document.documentElement.setAttribute('data-theme', 'dark');
    </script>
    <Analytics />
  </head>
  <body>
    <a class="skip-link" href="#main">跳转到主内容</a>
    <nav class="navbar" aria-label="主导航">
      <div class="navbar-inner">
        <a class="navbar-brand" href={BASE}>⚡ Walter's Tech Blog</a>
        <ul class="navbar-links">
          <li><a href={BASE} class={activeNav === 'blog' ? 'active' : ''}>博客</a></li>
          <li><a href={`${BASE}briefing/`} class={activeNav === 'briefing' ? 'active' : ''}>简报</a></li>
          <li><a href="https://github.com/walterwang0x01/tech-learning-and-projects" target="_blank" rel="noopener">GitHub ↗</a></li>
        </ul>
        <div class="navbar-actions">
          <button class="cmdk-trigger" id="cmdkTrigger" aria-label="搜索" title="搜索 (⌘K)">
            <span aria-hidden="true">🔎</span>
            <kbd class="kbd">⌘K</kbd>
          </button>
          <button class="menu-toggle" id="menuToggle" aria-label="打开导航菜单" aria-expanded="false">☰</button>
          <button class="theme-toggle" id="themeToggle" aria-label="切换主题">🌙</button>
        </div>
      </div>
      <ul class="mobile-nav" id="mobileNav">
        <li><a href={BASE} class={activeNav === 'blog' ? 'active' : ''}>博客</a></li>
        <li><a href={`${BASE}briefing/`} class={activeNav === 'briefing' ? 'active' : ''}>简报</a></li>
        <li><a href="https://github.com/walterwang0x01/tech-learning-and-projects" target="_blank" rel="noopener">GitHub ↗</a></li>
      </ul>
    </nav>
    <main id="main"><slot /></main>
    <footer>
      <p>© {new Date().getFullYear()} Walter's Tech Blog · Powered by Astro</p>
      <p class="visit-stats">
        👀 本页访问 <span id="busuanzi_value_page_pv">--</span> 次 · 全站访客 <span id="busuanzi_value_site_uv">--</span> 人
      </p>
    </footer>
    <BackToTop />
    <CommandPalette />
    <script>
      const toggle = document.getElementById('themeToggle');
      const root = document.documentElement;
      toggle?.addEventListener('click', () => {
        const cur = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-theme', cur);
        localStorage.setItem('theme', cur);
        if (toggle) toggle.textContent = cur === 'dark' ? '☀️' : '🌙';
      });
      if (toggle) toggle.textContent = root.getAttribute('data-theme') === 'dark' ? '☀️' : '🌙';
      const menuBtn = document.getElementById('menuToggle');
      const mobileNav = document.getElementById('mobileNav');
      menuBtn?.addEventListener('click', () => {
        const open = mobileNav?.classList.toggle('open');
        menuBtn.setAttribute('aria-expanded', String(!!open));
        menuBtn.textContent = open ? '✕' : '☰';
      });
      // 点击移动菜单链接后自动关闭
      mobileNav?.addEventListener('click', (e) => {
        const target = e.target as HTMLElement | null;
        if (target?.closest('a')) {
          mobileNav.classList.remove('open');
          menuBtn?.setAttribute('aria-expanded', 'false');
          if (menuBtn) menuBtn.textContent = '☰';
        }
      });
      // 点击菜单外部自动关闭（避免手机端要点两次才能关）
      document.addEventListener('click', (e) => {
        if (!mobileNav?.classList.contains('open')) return;
        const t = e.target as HTMLElement | null;
        if (t && !mobileNav.contains(t) && !menuBtn?.contains(t)) {
          mobileNav.classList.remove('open');
          menuBtn?.setAttribute('aria-expanded', 'false');
          if (menuBtn) menuBtn.textContent = '☰';
        }
      });
      // Cmd+K trigger buttons
      const cmdkTrigger = document.getElementById('cmdkTrigger');
      cmdkTrigger?.addEventListener('click', () => (window as any).__openCmdK?.());
      const heroCmdK = document.getElementById('openCmdK');
      heroCmdK?.addEventListener('click', () => (window as any).__openCmdK?.());

      // 全局 tag 点击 → 跳转到归档筛选页
      const BASE_URL = document.documentElement.dataset.base || '/portfolio/';
      document.addEventListener('click', (e) => {
        const t = e.target as HTMLElement | null;
        const badge = t?.closest?.('[data-tag]') as HTMLElement | null;
        if (!badge) return;
        // 阻止触发外层 <a> 的跳转（如 PostCard 整卡链接）
        e.preventDefault();
        e.stopPropagation();
        const tag = badge.getAttribute('data-tag') || '';
        if (tag) {
          location.href = `${BASE_URL}archive/?tag=${encodeURIComponent(tag)}`;
        }
      }, true); // capture 阶段，在 <a> 默认跳转之前拿到
      // 键盘可达（Enter/Space 触发）
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Enter' && e.key !== ' ') return;
        const t = e.target as HTMLElement | null;
        if (!t?.matches?.('[data-tag]')) return;
        e.preventDefault();
        const tag = t.getAttribute('data-tag') || '';
        if (tag) location.href = `${BASE_URL}archive/?tag=${encodeURIComponent(tag)}`;
      });
    </script>
  </body>
</html>
