---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import AuthorCard from '@/components/AuthorCard.astro';
import SubscribeCTA from '@/components/SubscribeCTA.astro';
import PostCard from '@/components/PostCard.astro';
import HeroParticles from '@/components/HeroParticles.astro';
import TypewriterTitle from '@/components/TypewriterTitle.astro';
import '@/styles/ai-notes.css';

const all = await getCollection('blog', ({ data }) => !data.draft);
const posts = all.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const picks = posts.slice(0, 3);
const BASE = import.meta.env.BASE_URL;

// JSON-LD 结构化数据（不影响视觉，放头部让搜索引擎更好识别）
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const blogLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: "Walter's Tech Blog",
  description: 'AI Agent 架构、工程实践与系统设计',
  url: siteUrl + BASE,
  author: { '@type': 'Person', name: 'Walter', url: 'https://github.com/walterwang0x01' },
  inLanguage: 'zh-CN',
};
const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: picks.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: `${siteUrl}${BASE}posts/${p.slug}/`,
    name: p.data.title,
  })),
};
---
<BaseLayout title="Walter's Tech Blog" activeNav="blog">
  <script type="application/ld+json" is:inline set:html={JSON.stringify(blogLd)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(itemListLd)} />

  <section class="hero hero--compact">
    <HeroParticles />
    <div class="hero-inner container-narrow">
      <div class="hero-eyebrow">⚡ AI Agent · 工程实践 · 系统设计</div>
      <h1 class="hero-title">
        用代码和思考<br />
        记录 <span class="hero-accent">AI Agent 时代</span>
      </h1>
      <p class="hero-subtitle">
        这里在写
        <TypewriterTitle phrases={[
          'Agent 架构与工程化',
          '多 Agent 协作',
          'Context Engineering',
          'MCP 与协议标准',
          'Coding Agent 内幕',
          'Agent 支付与安全',
        ]} />
        —— 深度内容，持续更新。
      </p>
      <div class="hero-actions">
        <a class="btn btn--primary" href="#picks">开始阅读 ↓</a>
        <button type="button" class="btn" id="openCmdK">
          <kbd class="kbd">⌘</kbd><kbd class="kbd">K</kbd> 搜索
        </button>
      </div>
    </div>
  </section>

  <section class="container-narrow entry-section">
    <div class="entry-grid">
      <a class="entry-card entry-card--notes" href={`${BASE}notes/`}>
        <div class="entry-top">
          <span class="entry-emoji">🧠</span>
          <span class="entry-badge">171 篇 · 198 题</span>
        </div>
        <h3>AI 知识库</h3>
        <p>从反向传播推导到生产级 Agent 系统。按学习依赖关系编排，带自测题和阅读进度。</p>
        <ul class="entry-feats">
          <li>🗺️ 5 阶段学习路线</li>
          <li>✍️ 198 道自测题</li>
          <li>📖 全文阅读 + 公式渲染</li>
        </ul>
        <span class="entry-cta">进入知识库 →</span>
      </a>

      <a class="entry-card entry-card--demos" href={`${BASE}demos/`}>
        <div class="entry-top">
          <span class="entry-emoji">🔬</span>
          <span class="entry-badge">4 个可交互</span>
        </div>
        <h3>原理可视化</h3>
        <p>把公式变成能拖动的东西。纯前端计算，调滑块就能看到机制如何变化。</p>
        <ul class="entry-feats">
          <li>注意力热力图</li>
          <li>反向传播梯度流（可复现死亡 ReLU）</li>
          <li>KV Cache 显存 · TIES 模型合并</li>
        </ul>
        <span class="entry-cta">打开演示 →</span>
      </a>
    </div>
  </section>

  <section class="container-narrow" id="picks">
    <AuthorCard />

    <header class="list-header">
      <h2 class="list-header-title">✨ 精选阅读</h2>
      <p class="list-header-desc">最新 3 篇，直接读</p>
    </header>
    <div class="post-list">
      {picks.map((p) => <PostCard post={p} />)}
    </div>

    <div class="archive-link-wrap">
      <a class="btn btn--primary btn--wide" href={`${BASE}archive/`}>
        浏览全部 {posts.length} 篇文章 →
      </a>
    </div>

    <SubscribeCTA />
  </section>
</BaseLayout>
