---
import BaseLayout from '@/layouts/BaseLayout.astro';

const briefingsBase = `${import.meta.env.BASE_URL}briefings/`;
---
<BaseLayout title="每日简报 — Walter's Tech Blog" description="AI Agent · 国内科技 · 国际科技每日简报" activeNav="briefing">
  <section class="container-narrow">
    <header class="page-hero">
      <h1>📰 每日技术简报</h1>
      <p>AI Agent · 国内科技 · 国际科技 — 每日精选，自动采集</p>
    </header>
    <div id="topicTabs" class="tag-filter" role="toolbar" aria-label="主题切换">
      <button type="button" class="badge active" data-topic="ai-agent">🤖 AI Agent</button>
      <button type="button" class="badge" data-topic="china-tech">🇨🇳 国内科技</button>
      <button type="button" class="badge" data-topic="global-tech">🌍 国际科技</button>
    </div>
    <div id="dateList" class="date-strip" aria-label="日期列表"></div>
    <div id="briefingContent" class="post-body briefing-panel">
      <div class="empty">加载中…</div>
    </div>
  </section>
  <script src="https://cdn.jsdelivr.net/npm/marked@15/marked.min.js"></script>
  <script src={`${import.meta.env.BASE_URL}js/briefing-viewer.js`}></script>
  <script is:inline define:vars={{ briefingsBase }}>
    window.BriefingViewer.create({ briefingsBase });
  </script>
</BaseLayout>
