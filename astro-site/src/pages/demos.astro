---
import BaseLayout from '@/layouts/BaseLayout.astro';
import '@/styles/ai-notes.css';

const notesUrl = `${import.meta.env.BASE_URL}notes/`;

const DEMOS = [
  {
    id: 'attention',
    tab: '注意力热力图',
    h2: '注意力机制：每个词在看谁',
    desc: '自注意力的核心是 <code>softmax(QKᵀ/√d)</code>。矩阵每一行是一个 query token，列是它能看到的 key token，格子里的数字是分配的注意力权重（百分比，每行和为 100%）。<b>颜色越红代表关注度越高。</b>',
    points: [
      '<b>Causal mask 的作用</b>：取消勾选后右上三角会出现数值——那是 BERT 这类 encoder 的双向注意力；勾选时被屏蔽，因为 GPT 生成时不能看到未来的词',
      '<b>Temperature 的影响</b>：调低（→0.2）注意力会集中到单个 token，调高（→3）会趋于均匀。这就是为什么采样温度影响输出确定性',
      '<b>第一行永远是 100%</b>：第一个 token 只能看自己，softmax 单个元素必然为 1',
      '⚠️ Q/K 向量由词的哈希生成（保证同词同结果），不是真实训练出来的语义向量，所以「谁关注谁」没有语义含义。这里演示的是<b>机制</b>而非语义',
    ],
    note: '02-llm/01-Transformer原理/01-注意力机制推导.md',
    noteLabel: '注意力机制推导',
  },
  {
    id: 'backprop',
    tab: '反向传播',
    h2: '反向传播：梯度怎么从损失回流到参数',
    desc: '一个最小网络：<code>x → 线性层 → ReLU → 线性层 → MSE 损失</code>。上半部分是前向传播的数值，下半部分是链式法则逐层求出的梯度。点「训练一步」看参数如何更新。',
    points: [
      '<b>把 x 调到负数</b>（比如 -1）：z₁ 变负 → ReLU 导数变 0 → 第一层参数梯度归零，永远学不动。这就是<b>死亡 ReLU</b>',
      '<b>把学习率调到 0.5</b> 再连续跑：Loss 可能反而震荡上升——步长过大越过了最小值',
      '<b>梯度是连乘的</b>：<code>∂L/∂w₁ = ∂L/∂ŷ · w₂ · ReLU′ · x</code>。层数深了以后，这条链上任何一项接近 0，前面的参数就收不到信号——这是梯度消失的根源',
    ],
    note: '01-machine-learning/04-神经网络原理/02-反向传播推导.md',
    noteLabel: '反向传播推导',
  },
  {
    id: 'kvcache',
    tab: 'KV Cache 显存',
    h2: 'KV Cache：长上下文的显存代价',
    desc: '自回归生成时，每个已生成 token 的 K/V 都要缓存下来供后续复用。这块显存随序列长度<b>线性增长</b>，长上下文的成本主要来自这里。',
    points: [
      '<b>把序列长度从 8K 拉到 128K</b>：显存涨 16 倍。这就是为什么长上下文贵，也是 PagedAttention / 分页管理存在的原因',
      '<b>GQA 的价值</b>：Llama 3 8B 的 32 个 attention head 只共享 8 组 KV，显存直接降到 1/4，而效果损失很小',
      '<b>int8 量化 KV Cache</b>：切换精度看显存变化。这是长上下文场景常用的优化，代价是轻微精度损失',
      '<b>Batch 是乘性的</b>：并发请求越多，KV Cache 越吃紧。这决定了推理服务的吞吐上限',
    ],
    note: '02-llm/05-推理优化/01-KV-Cache与显存分析.md',
    noteLabel: 'KV Cache 与显存分析',
  },
  {
    id: 'ties',
    tab: 'TIES 模型合并',
    h2: 'TIES 模型合并：符号冲突怎么解决',
    desc: '把两个微调模型合并成一个时，同一参数位置上它们可能想要<b>相反</b>的调整。直接平均会互相抵消，TIES 用「修剪 → 符号选举 → 不相交平均」三步保留占优方向。',
    points: [
      '<b>红色是正向调整，蓝色是负向</b>。位置 0、1 上 A 想要正、B 想要负，这就是符号冲突',
      '<b>对比最后两行</b>：TIES 在冲突位置保留了完整幅度，朴素平均把 +0.8 和 -0.7 抵消成 +0.05，两个模型的能力都没保住',
      '<b>调低 Trim 比例</b>：会丢掉更多小幅值参数。小幅值大多是噪声，修剪掉反而更干净，但过低会丢真实信息',
      '<b>零值格子</b>：被 Trim 掉或符号不一致被丢弃的位置',
    ],
    note: '02-llm/04-微调与对齐/05-模型合并.md',
    noteLabel: '模型合并',
  },
];
---
<BaseLayout
  title="AI 原理可视化 — Walter's Tech Blog"
  description="交互式演示：注意力机制热力图、反向传播梯度流、KV Cache 显存计算、TIES 模型合并符号选举"
  activeNav="demos"
  ogImage={`${import.meta.env.BASE_URL}og-page/demos.png`}
>
  <section class="ai-container demos-page">
    <header class="ai-page-hero">
      <h1>AI 原理可视化</h1>
      <p>把公式变成能拖动的东西。纯前端计算，无后端无 API 调用。</p>
    </header>

    <nav class="demo-tabs" role="tablist">
      {DEMOS.map((d, i) => (
        <button class={`demo-tab${i === 0 ? ' active' : ''}`} data-demo-tab={d.id} role="tab">{d.tab}</button>
      ))}
    </nav>

    {DEMOS.map((d, i) => (
      <div class="demo-panel" data-demo={d.id} hidden={i !== 0}>
        <h2>{d.h2}</h2>
        <p class="demo-desc" set:html={d.desc} />
        <div class="demo-host" data-demo-host={d.id}></div>

        <details class="demo-note">
          <summary>这个演示说明了什么</summary>
          <ul>
            {d.points.map((p) => <li set:html={p} />)}
          </ul>
        </details>

        <a class="demo-related" href={`${notesUrl}#read/${encodeURIComponent(d.note)}`}>
          <span class="dr-icon">📖</span>
          <span class="dr-main">
            <b>对应笔记：{d.noteLabel}</b>
            <small>完整推导、代码实现与延伸阅读</small>
          </span>
          <span class="dr-arrow">→</span>
        </a>
      </div>
    ))}

    <footer class="demos-footer">
      <p>
        <a href="https://github.com/walterwang0x01/portfolio/blob/main/astro-site/public/js/ai-demos.js" target="_blank" rel="noopener">查看源码 ↗</a>
        　·　这些演示也内嵌在<a href={notesUrl}>对应笔记</a>里，读到相关章节就能直接拖
      </p>
    </footer>
  </section>

  <script src={`${import.meta.env.BASE_URL}js/ai-demos.js`}></script>
  <script is:inline>
    (function () {
      // 挂载全部 demo（首屏只挂第一个，切 tab 时懒挂其余）
      const mounted = new Set();
      function mountIfNeeded(id) {
        if (mounted.has(id)) return;
        const host = document.querySelector(`[data-demo-host="${id}"]`);
        if (host && window.AIDemos?.mount(id, host)) mounted.add(id);
      }

      document.querySelectorAll('[data-demo-tab]').forEach((tab) => {
        tab.addEventListener('click', () => {
          const id = tab.dataset.demoTab;
          document.querySelectorAll('[data-demo-tab]').forEach((t) => t.classList.toggle('active', t === tab));
          document.querySelectorAll('.demo-panel').forEach((p) => (p.hidden = p.dataset.demo !== id));
          mountIfNeeded(id);
          history.replaceState(null, '', '#' + id);
        });
      });

      const hash = location.hash.slice(1);
      const initial = document.querySelector(`[data-demo-tab="${hash}"]`);
      if (initial) initial.click();
      else mountIfNeeded(document.querySelector('[data-demo-tab]').dataset.demoTab);
    })();
  </script>
</BaseLayout>
