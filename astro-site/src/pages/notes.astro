---
import BaseLayout from '@/layouts/BaseLayout.astro';

const notesBase = `${import.meta.env.BASE_URL}notes/`;
---
<BaseLayout title="AI 知识库 — Walter's Tech Blog" description="AI Agent、机器学习、大模型原理 190+ 篇技术笔记" activeNav="notes">
  <section class="notes-layout">
    <aside class="notes-sidebar" id="notesSidebar">
      <div class="sidebar-header">
        <h2>📚 AI 知识库</h2>
        <button class="sidebar-close" id="sidebarClose" aria-label="关闭侧栏">✕</button>
      </div>
      <div class="sidebar-search">
        <input type="search" id="notesSearch" placeholder="搜索笔记…" aria-label="搜索笔记" />
      </div>
      <nav id="notesTree" class="tree" aria-label="笔记目录"></nav>
    </aside>
    <main class="notes-main">
      <button class="sidebar-toggle" id="sidebarToggle" aria-label="打开目录">☰ 目录</button>
      <article id="notesContent" class="post-body">
        <div class="notes-welcome">
          <h1>🧠 AI 知识库</h1>
          <p>从机器学习基础到生产级 Agent 系统，167 篇原创技术笔记。</p>
          <p class="hint">← 从左侧目录选择一篇开始阅读</p>
          <div class="notes-stats" id="notesStats"></div>
        </div>
      </article>
    </main>
  </section>

  <script src="https://cdn.jsdelivr.net/npm/marked@15/marked.min.js"></script>
  <script is:inline define:vars={{ notesBase }}>
  (function() {
    const tree = document.getElementById('notesTree');
    const content = document.getElementById('notesContent');
    const searchInput = document.getElementById('notesSearch');
    const sidebar = document.getElementById('notesSidebar');
    const sidebarToggle = document.getElementById('sidebarToggle');
    const sidebarClose = document.getElementById('sidebarClose');

    let manifest = null;
    let allFiles = [];

    // 侧栏切换
    sidebarToggle.addEventListener('click', () => sidebar.classList.add('open'));
    sidebarClose.addEventListener('click', () => sidebar.classList.remove('open'));

    async function init() {
      const resp = await fetch(notesBase + 'manifest.json');
      manifest = await resp.json();
      allFiles = collectFiles(manifest.tree);
      renderTree(manifest.tree.children, tree, '');
      document.getElementById('notesStats').innerHTML =
        `<span>${manifest.count} 篇笔记</span>`;

      // URL hash 导航
      if (location.hash) {
        const file = decodeURIComponent(location.hash.slice(1));
        if (file) loadNote(file);
      }
    }

    function collectFiles(node) {
      let files = [...(node.files || [])];
      for (const child of (node.children || [])) {
        files = files.concat(collectFiles(child));
      }
      return files;
    }

    function renderTree(children, container, prefix) {
      container.innerHTML = '';
      for (const node of children) {
        const details = document.createElement('details');
        const summary = document.createElement('summary');
        const dirName = node.name.replace(/^.*\//, '');
        summary.textContent = dirName.replace(/^\d+-/, '');
        details.appendChild(summary);

        // 该目录下的文件
        if (node.files && node.files.length) {
          const ul = document.createElement('ul');
          for (const f of node.files) {
            const li = document.createElement('li');
            const a = document.createElement('a');
            a.href = '#' + encodeURIComponent(f);
            a.textContent = f.replace(/^.*\//, '').replace(/\.md$/, '').replace(/^\d+-/, '');
            a.addEventListener('click', (e) => {
              e.preventDefault();
              loadNote(f);
              history.pushState(null, '', '#' + encodeURIComponent(f));
              sidebar.classList.remove('open');
            });
            li.appendChild(a);
            ul.appendChild(li);
          }
          details.appendChild(ul);
        }

        // 子目录递归
        if (node.children && node.children.length) {
          const inner = document.createElement('div');
          inner.className = 'tree-nested';
          renderTree(node.children, inner, node.name);
          // 把 inner 的子节点追加（不嵌套多余 div）
          for (const child of [...inner.children]) {
            details.appendChild(child);
          }
        }

        container.appendChild(details);
      }
    }

    async function loadNote(filePath) {
      content.innerHTML = '<div class="loading">加载中…</div>';
      try {
        const resp = await fetch(notesBase + filePath);
        if (!resp.ok) throw new Error(resp.statusText);
        const md = await resp.text();
        content.innerHTML = marked.parse(md);
        content.scrollTop = 0;
        // 高亮当前
        document.querySelectorAll('.tree a.active').forEach(a => a.classList.remove('active'));
        const current = document.querySelector(`.tree a[href="#${CSS.escape(encodeURIComponent(filePath))}"]`);
        if (current) {
          current.classList.add('active');
          // 展开父级 details
          let el = current;
          while (el) {
            if (el.tagName === 'DETAILS') el.open = true;
            el = el.parentElement;
          }
        }
      } catch (e) {
        content.innerHTML = `<div class="error">加载失败: ${e.message}</div>`;
      }
    }

    // 搜索过滤
    searchInput.addEventListener('input', () => {
      const q = searchInput.value.toLowerCase().trim();
      document.querySelectorAll('.tree a').forEach(a => {
        const match = !q || a.textContent.toLowerCase().includes(q);
        a.closest('li').style.display = match ? '' : 'none';
      });
      if (q) {
        document.querySelectorAll('.tree details').forEach(d => d.open = true);
      }
    });

    // hash 变化
    window.addEventListener('hashchange', () => {
      const file = decodeURIComponent(location.hash.slice(1));
      if (file) loadNote(file);
    });

    init();
  })();
  </script>

  <style>
    .notes-layout {
      display: flex;
      min-height: calc(100vh - 64px);
    }
    .notes-sidebar {
      width: 300px;
      border-right: 1px solid var(--border-color);
      overflow-y: auto;
      padding: 16px;
      position: sticky;
      top: 64px;
      height: calc(100vh - 64px);
      flex-shrink: 0;
      background: var(--bg-secondary);
    }
    .sidebar-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 12px;
    }
    .sidebar-header h2 { font-size: 16px; margin: 0; }
    .sidebar-close { display: none; background: none; border: none; font-size: 20px; cursor: pointer; color: var(--text-secondary); }
    .sidebar-search input {
      width: 100%;
      padding: 8px 12px;
      border: 1px solid var(--border-color);
      border-radius: 6px;
      font-size: 13px;
      background: var(--card-bg);
      color: var(--text-primary);
      margin-bottom: 12px;
    }
    .notes-main {
      flex: 1;
      padding: 32px 48px;
      max-width: 860px;
      overflow-y: auto;
    }
    .sidebar-toggle {
      display: none;
      margin-bottom: 16px;
      padding: 8px 16px;
      border: 1px solid var(--border-color);
      border-radius: 6px;
      background: var(--card-bg);
      cursor: pointer;
      font-size: 14px;
      color: var(--text-secondary);
    }
    .notes-welcome { text-align: center; padding: 60px 0; }
    .notes-welcome h1 { font-size: 28px; }
    .notes-welcome .hint { color: var(--text-secondary); margin-top: 12px; }
    .notes-stats { margin-top: 16px; color: var(--text-secondary); font-size: 14px; }
    .loading, .error { padding: 40px; text-align: center; color: var(--text-secondary); }

    /* 目录树 */
    .tree details { margin-left: 0; }
    .tree details details { margin-left: 12px; }
    .tree summary {
      cursor: pointer;
      font-size: 13px;
      font-weight: 600;
      padding: 4px 0;
      color: var(--text-primary);
      list-style: none;
    }
    .tree summary::before { content: '▸ '; color: var(--text-secondary); }
    .tree details[open] > summary::before { content: '▾ '; }
    .tree ul { list-style: none; padding-left: 16px; margin: 2px 0; }
    .tree li { margin: 1px 0; }
    .tree a {
      font-size: 13px;
      color: var(--text-secondary);
      text-decoration: none;
      padding: 3px 8px;
      border-radius: 4px;
      display: block;
      transition: background 0.15s;
    }
    .tree a:hover { background: var(--bg-secondary); color: var(--text-primary); }
    .tree a.active { background: var(--primary); color: #fff; }

    @media (max-width: 768px) {
      .notes-sidebar {
        position: fixed;
        left: -100%;
        top: 0;
        height: 100vh;
        z-index: 100;
        width: 280px;
        transition: left 0.2s;
      }
      .notes-sidebar.open { left: 0; }
      .sidebar-close { display: block; }
      .sidebar-toggle { display: block; }
      .notes-main { padding: 16px; }
    }
  </style>
</BaseLayout>
