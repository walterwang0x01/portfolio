---
import { pickGradient, pickEmoji, readingMinutes, pickTagColorIndex, type RelatedCandidate } from '@/lib/post-utils';

interface Props {
  posts: RelatedCandidate[];
}

const { posts } = Astro.props;
const BASE = import.meta.env.BASE_URL;

const cards = posts.map((p) => {
  const tag0 = p.data.tags[0] ?? '';
  return {
    slug: p.slug,
    title: p.data.title,
    dateStr: p.data.date.toISOString().slice(0, 10),
    tags: p.data.tags.slice(0, 2),
    cover: p.data.cover,
    emoji: pickEmoji(p.data.tags, p.data.emoji),
    gradient: pickGradient(tag0 || p.slug),
    minutes: readingMinutes(p.body),
  };
});
---
{cards.length > 0 && (
  <section class="related" aria-label="相关阅读">
    <h2 class="related-title">📌 相关阅读</h2>
    <div class="related-grid">
      {cards.map((c) => (
        <a class="post-card related-card" href={`${BASE}posts/${c.slug}/`}>
          <div class="cover" style={c.cover ? `background-image: url('${c.cover}')` : c.gradient ? `background-image: ${c.gradient}` : ''}>
            {!c.cover && <span class="cover-emoji" aria-hidden="true">{c.emoji}</span>}
          </div>
          <div class="post-card-body">
            <h3 class="related-heading">{c.title}</h3>
            <div class="meta">
              <time datetime={c.dateStr}>{c.dateStr}</time>
              <span aria-hidden="true">·</span>
              <span>🕒 {c.minutes} 分钟</span>
            </div>
            <div class="row card-tags">
              {c.tags.map((t) => <span class="badge" data-color={pickTagColorIndex(t)}>{t}</span>)}
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>
)}
