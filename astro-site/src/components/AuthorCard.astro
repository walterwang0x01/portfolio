---
// 关于作者小卡。默认紧凑一行，点击展开完整信息。
const AUTHOR = {
  name: 'Walter',
  handle: '@walterwang0x01',
  bio: '专注 AI Agent 架构与工程实践，分享从 0 到 1 的构建经验与踩坑心得。',
  avatar: 'https://github.com/walterwang0x01.png',
  links: [
    { label: 'GitHub', href: 'https://github.com/walterwang0x01', icon: '⭐' },
    { label: 'RSS', href: '/portfolio/rss.xml', icon: '📡' },
    { label: '简报', href: '/portfolio/briefing/', icon: '📰' },
  ],
};
---
<details class="author-card" aria-label="关于作者">
  <summary class="author-summary">
    <img
      class="author-avatar"
      src={AUTHOR.avatar}
      alt={`${AUTHOR.name} 的头像`}
      width="40"
      height="40"
      loading="lazy"
    />
    <div class="author-summary-text">
      <span class="author-name">{AUTHOR.name}</span>
      <span class="author-handle">{AUTHOR.handle}</span>
    </div>
    <span class="author-chevron" aria-hidden="true">▸</span>
  </summary>
  <div class="author-body">
    <p class="author-bio">{AUTHOR.bio}</p>
    <div class="author-links">
      {AUTHOR.links.map((l) => (
        <a
          class="author-link"
          href={l.href}
          target={l.href.startsWith('http') ? '_blank' : undefined}
          rel={l.href.startsWith('http') ? 'noopener' : undefined}
        >
          <span aria-hidden="true">{l.icon}</span>
          {l.label}
        </a>
      ))}
    </div>
  </div>
</details>
