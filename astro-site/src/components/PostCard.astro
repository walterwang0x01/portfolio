---
import { pickGradient, pickEmoji, readingMinutes } from '@/lib/post-utils';

interface Post {
  slug: string;
  body: string;
  data: {
    title: string;
    date: Date;
    tags: string[];
    excerpt: string;
    cover?: string;
    emoji?: string;
  };
}

interface Props {
  post: Post;
  featured?: boolean;
  maxTags?: number;
}

const { post, featured = false, maxTags = 3 } = Astro.props;
const BASE = import.meta.env.BASE_URL;

const tag0 = post.data.tags[0] ?? '';
const dateStr = post.data.date.toISOString().slice(0, 10);
const emoji = pickEmoji(post.data.tags, post.data.emoji);
const gradient = pickGradient(tag0 || post.slug);
const minutes = readingMinutes(post.body);
const coverStyle = post.data.cover
  ? `background-image: url('${post.data.cover}')`
  : `background-image: ${gradient}`;
const tagsShown = post.data.tags.slice(0, maxTags);
---
<a
  class={`post-card ${featured ? 'post-card--featured' : ''}`}
  href={`${BASE}posts/${post.slug}/`}
  data-title={post.data.title}
  data-excerpt={post.data.excerpt}
  data-tags={post.data.tags.join(',')}
>
  <div class={`cover ${featured ? 'cover--featured' : ''}`} style={coverStyle}>
    {!post.data.cover && <span class="cover-emoji" aria-hidden="true">{emoji}</span>}
    {featured && <span class="cover-badge">置顶</span>}
  </div>
  <div class="post-card-body">
    <h2>{post.data.title}</h2>
    <div class="meta">
      <time datetime={dateStr}>{dateStr}</time>
      <span aria-hidden="true">·</span>
      <span>🕒 {minutes} 分钟</span>
    </div>
    <p class="excerpt">{post.data.excerpt}</p>
    <div class="row card-tags">
      {tagsShown.map((t) => <span class="badge">{t}</span>)}
    </div>
  </div>
</a>
