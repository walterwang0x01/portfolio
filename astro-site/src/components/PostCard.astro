---
import { pickGradient, pickEmoji, readingMinutes, pickTagColorIndex } from '@/lib/post-utils';

interface Post {
  slug: string;
  body: string;
  data: {
    title: string;
    date: Date;
    tags: string[];
    excerpt: string;
    cover?: string;
    emoji?: string;
  };
}

interface Props {
  post: Post;
  maxTags?: number;
}

const { post, maxTags = 2 } = Astro.props;
const BASE = import.meta.env.BASE_URL;

const tag0 = post.data.tags[0] ?? '';
const dateStr = post.data.date.toISOString().slice(0, 10);
const emoji = pickEmoji(post.data.tags, post.data.emoji);
const gradient = pickGradient(tag0 || post.slug);
const minutes = readingMinutes(post.body);
const thumbStyle = post.data.cover
  ? `background-image: url('${post.data.cover}')`
  : `background-image: ${gradient}`;
const tagsShown = post.data.tags.slice(0, maxTags);
---
<a
  class="post-row"
  href={`${BASE}posts/${post.slug}/`}
  data-title={post.data.title}
  data-excerpt={post.data.excerpt}
  data-tags={post.data.tags.join(',')}
>
  <div class="post-row-thumb" style={thumbStyle}>
    {!post.data.cover && <span class="post-row-emoji" aria-hidden="true">{emoji}</span>}
  </div>
  <div class="post-row-body">
    <h3 class="post-row-title">{post.data.title}</h3>
    <p class="post-row-excerpt">{post.data.excerpt}</p>
    <div class="post-row-meta">
      <time datetime={dateStr}>{dateStr}</time>
      <span class="dot" aria-hidden="true">·</span>
      <span>🕒 {minutes} 分钟</span>
      {tagsShown.map((t) => (
        <>
          <span class="dot" aria-hidden="true">·</span>
          <span class="badge" data-color={pickTagColorIndex(t)}>{t}</span>
        </>
      ))}
    </div>
  </div>
</a>
