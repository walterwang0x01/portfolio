{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🌐 Astro dev",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}/astro-site",
